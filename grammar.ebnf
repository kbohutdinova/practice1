program ::= { statement } exit_stmt

statement ::= decl
            | assign
            | if_stmt
            | while_stmt

decl ::= type [ "mut" ] ident "{" expr "}"

type ::= "i32" | "i64" | "bool"

assign ::= ident ":=" expr

if_stmt ::= "if" expr newline block
            [ "else" newline block ]

while_stmt ::= "while" expr newline block

block ::= "{" newline
          statement_list
          [ exit_stmt newline ]
          "}" newline

statement_list ::= statement { newline statement }

exit_stmt ::= "exit" factor

expr ::= arithmetic_expr
         [ ("==" | "!=") arithmetic_expr ]

arithmetic_expr ::= term { ("+" | "-") term }

term ::= factor { "*" factor }

factor ::= number
         | "true"
         | "false"
         | ident
         | "!" factor

number ::= digit { digit }

ident ::= letter { letter | digit | "_" }

newline ::= NEWLINE
